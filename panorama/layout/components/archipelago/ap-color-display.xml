<root>
    <styles>
        <include src="file://{resources}/styles/main.scss" />
    </styles>
    <scripts>
        <include src="file://{scripts}/components/archipelago/ap-color-display.js" />
    </scripts>

    <Panel class="colordisplay" onload="ApColorDisplay.init();" style="flow-children: right; width: 100%; vertical-align: middle;">
        <Label id="Title" class="colordisplay__title" style="vertical-align: middle;" />
        <Panel id="Display" class="colordisplay__display" onactivate="ApColorDisplay.showPopup()" acceptsinput="true" style="vertical-align: middle;" />
        <TextEntry id="Hex" class="textentry colordisplay__hexentry" textmode="hex" maxchars="8" style="vertical-align: middle;" />
        
        <Button id="RandomColorBtn" class="button random" style="vertical-align: middle; margin-left: 8px; width: 42px; height: 42px;">
            <Image class="button__icon" style="width: 40px; height: 40px; align: center center;" src="file://{images}/archipelago/dice-solid-full.svg" />
        </Button>
        
        <Button id="RainbowColorBtn" class="button rainbow" style="vertical-align: middle; margin-left: 4px; width: 42px; height: 42px;">
            <Image class="button__icon" style="width: 40px; height: 40px; align: center center;" src="file://{images}/archipelago/rainbow-solid-full.svg" />
        </Button>
    </Panel>
</root>