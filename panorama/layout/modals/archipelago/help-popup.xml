					<Label class="help-popup__section-title" text="#Archipelago_Help_Section_Notifications_Items" />

					<!-- Item Received -->
					<Panel class="help-popup__notify-row">
						<Panel class="notify-entry">
							<Panel class="notify-main-row">
								<Panel class="accent-bar" style="background-color: rgb(64, 160, 255);" />
								<Panel class="content">
									<Label class="title" style="color: rgb(64, 160, 255);" text="#Archipelago_HUD_Receive" />
									<Label class="body" text="#Archipelago_Help_Notify_Receive_Desc" />
								</Panel>
							</Panel>
							<Panel class="timer-bar timer-preview" style="background-color: rgb(64, 160, 255);" />
						</Panel>
					</Panel>

					<!-- Item Sent -->
					<Panel class="help-popup__notify-row">
						<Panel class="notify-entry">
							<Panel class="notify-main-row">
								<Panel class="accent-bar" style="background-color: rgb(255, 160, 32);" />
								<Panel class="content">
									<Label class="title" style="color: rgb(255, 160, 32);" text="#Archipelago_HUD_Send" />
									<Label class="body" text="#Archipelago_Help_Notify_Send_Desc" />
								</Panel>
							</Panel>
							<Panel class="timer-bar timer-preview" style="background-color: rgb(255, 160, 32);" />
						</Panel>
					</Panel>

					<!-- Item Found -->
					<Panel class="help-popup__notify-row">
						<Panel class="notify-entry">
							<Panel class="notify-main-row">
								<Panel class="accent-bar" style="background-color: rgb(50, 255, 50);" />
								<Panel class="content">
									<Label class="title" style="color: rgb(50, 255, 50);" text="#Archipelago_HUD_Found" />
									<Label class="body" text="#Archipelago_Help_Notify_Found_Desc" />
								</Panel>
							</Panel>
							<Panel class="timer-bar timer-preview" style="background-color: rgb(50, 255, 50);" />
						</Panel>
					</Panel>

					<!-- New Hint -->
					<Panel class="help-popup__notify-row">
						<Panel class="notify-entry">
							<Panel class="notify-main-row">
								<Panel class="accent-bar" style="background-color: rgb(255, 255, 50);" />
								<Panel class="content">
									<Label class="title" style="color: rgb(255, 255, 50);" text="#Archipelago_HUD_Hint" />
