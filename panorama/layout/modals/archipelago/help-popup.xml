					<Panel class="help-popup__notify-row">
						<Panel class="notify-entry">
							<Panel class="notify-main-row">
								<Panel class="accent-bar rainbow-bg" />
								<Panel class="content">
									<Label class="title rainbow-text" text="#Archipelago_HUD_GoMode" />
