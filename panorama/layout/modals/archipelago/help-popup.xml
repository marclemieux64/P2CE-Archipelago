								<Panel class="content">
									<Label class="title" style="color: rgb(255, 215, 0);" text="#Archipelago_HUD_Goal" />
									<Label class="body" text="#Archipelago_Help_Notify_Goal_Desc" />
								</Panel>
							</Panel>
							<Panel class="timer-bar timer-preview" style="background-color: rgb(255, 215, 0);" />
