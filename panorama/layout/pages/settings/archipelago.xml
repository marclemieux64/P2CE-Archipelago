<root>
    <styles>
        <include src="file://{resources}/styles/main.scss" />
    </styles>
    <scripts>
        <include src="file://{scripts}/pages/settings/page.js" />
		<include src="file://{scripts}/components/color-display.js" />
        <include src="file://{scripts}/pages/settings/archipelago.ts" />
    </scripts>

    <Panel class="settings-page" searchtitle="#Archipelago_Settings_Title">
        <Panel id="SettingsPageContainer" class="settings-page__container" style="overflow: squish scroll; flow-children: down; height: 100%; width: 100%;">

            <Panel id="ArchipelagoGeneral" class="settings-group">
                <Panel class="settings-group__header">
                    <Label class="settings-group__title" text="#Archipelago_Settings_General" />
                </Panel>

                <SettingsEnum
                    id="HideCountsSetting"
                    text="#Archipelago_Settings_HideLocationCounts"
                    psvar="cv_HideLocationCounts"
                    infomessage="#Archipelago_Settings_HideLocationCounts_info"
                    hasdocspage="false"
                >
                    <RadioButton group="cv_HideLocationCounts" text="#Common_Show" value="0" />
                    <RadioButton group="cv_HideLocationCounts" text="#Common_Hide" value="1" />
                </SettingsEnum>

                <SettingsEnum
                    id="AutoSmartWarpSetting"
                    text="#Archipelago_Settings_AutoSmartWarp"
                    psvar="cv_AutoSmartWarp"
                    infomessage="#Archipelago_Settings_AutoSmartWarp_info"
                    hasdocspage="false"
                >
                    <RadioButton group="cv_AutoSmartWarp" text="#Common_Off" value="0" />
                    <RadioButton group="cv_AutoSmartWarp" text="#Common_On" value="1" />
                </SettingsEnum>

                <SettingsEnum
                    id="ReleasePromptSetting"
                    text="#Archipelago_Settings_ReleasePrompt"
                    psvar="cv_ReleasePrompt"
                    infomessage="#Archipelago_Settings_ReleasePrompt_info"
                    hasdocspage="false"
                >
                    <RadioButton group="cv_ReleasePrompt" text="#Common_Off" value="0" />
                    <RadioButton group="cv_ReleasePrompt" text="#Common_On" value="1" />
                </SettingsEnum>

                <SettingsEnumDropDown
                    text="#Archipelago_Settings_TransitionType"
                    infomessage="#Archipelago_Settings_TransitionType_info"
                    submitoverride="UiToolkitAPI.GetGlobalObject().SaveSmartWarpSetting()"
                    id="TransitionTypeSetting"
                    psvar="cv_SmartWarp"
                >
                    <Label text="#Archipelago_Settings_Transition_Menu" value="0" id="ap_transition_menu" />
                    <Label text="#Archipelago_Settings_Transition_Smart" value="1" id="ap_transition_smart" />
                </SettingsEnumDropDown>

                <SettingsEnum
                    id="MapStatusHUDSetting"
                    text="#Archipelago_Settings_MapStatusHUD"
                    convar="cv_ShowMapStatusHUD"
                    psvar="cv_ShowMapStatusHUD"
                    infomessage="#Archipelago_Settings_MapStatusHUD_info"
                    hasdocspage="false"
                >
                    <RadioButton group="cv_ShowMapStatusHUD" text="#Common_Show" value="0" activateoverride="UiToolkitAPI.GetGlobalObject().SaveMapStatusHUDSetting?.()" />
                    <RadioButton group="cv_ShowMapStatusHUD" text="#Common_Hide" value="1" activateoverride="UiToolkitAPI.GetGlobalObject().SaveMapStatusHUDSetting?.()" />
                </SettingsEnum>
                
                <SettingsKeyBinder
                    id="MapStatusKeyBinder"
                    text="#Archipelago_Settings_Key_ShowStatus"
                    infomessage="#Archipelago_Settings_Key_ShowStatus_info"
                    bind="ShowStatus"
                />

                <SettingsEnumDropDown
                    id="HideHologramsSetting"
                    text="#Archipelago_Settings_HideHolograms"
                    infomessage="#Archipelago_Settings_HideHolograms_info"
                    submitoverride="UiToolkitAPI.GetGlobalObject().SaveHideHologramsSetting()"
                    convar="cv_HideHolograms"
                    psvar="cv_HideHolograms"
                >
                    <Label text="#Archipelago_Settings_HideHolograms_0" value="0" id="cv_HideHolograms_0" />
                    <Label text="#Archipelago_Settings_HideHolograms_1" value="1" id="cv_HideHolograms_1" />
                    <Label text="#Archipelago_Settings_HideHolograms_2" value="2" id="cv_HideHolograms_2" />
                </SettingsEnumDropDown>

                <SettingsEnumDropDown
                    id="StatusIndicatorModeSetting"
                    text="#Archipelago_Settings_StatusIndicatorMode"
                    infomessage="#Archipelago_Settings_StatusIndicatorMode_info"
                    submitoverride="UiToolkitAPI.GetGlobalObject().SaveStatusIndicatorModeSetting()"
                    psvar="cv_StatusIndicatorMode"
                >
                    <Label text="#Archipelago_Settings_StatusIndicatorMode_0" value="0" id="cv_StatusIndicatorMode_0" />
                    <Label text="#Archipelago_Settings_StatusIndicatorMode_1" value="1" id="cv_StatusIndicatorMode_1" />
                    <Label text="#Archipelago_Settings_StatusIndicatorMode_2" value="2" id="cv_StatusIndicatorMode_2" />
                </SettingsEnumDropDown>
            </Panel>

            <Panel class="settings-page__spacer" />

            <Panel id="ArchipelagoSkips" class="settings-group">
                <Panel class="settings-group__header">
                    <Label class="settings-group__title" text="#Archipelago_Settings_Skips" />
                </Panel>

                <SettingsEnum
                    id="SkipElevatorRideSetting"
                    text="#Archipelago_Settings_SkipElevatorRide"
                    convar="cv_SkipElevatorRide"
                    psvar="cv_SkipElevatorRide"
                    infomessage="#Archipelago_Settings_SkipElevatorRide_info"
                    hasdocspage="false"
                >
                    <RadioButton group="cv_SkipElevatorRide" text="#Common_Off" value="0" activateoverride="UiToolkitAPI.GetGlobalObject().SyncSkipSettingsIfInGame?.()" />
                    <RadioButton group="cv_SkipElevatorRide" text="#Common_On" value="1" activateoverride="UiToolkitAPI.GetGlobalObject().SyncSkipSettingsIfInGame?.()" />
                </SettingsEnum>

                <SettingsEnum
                    id="SkipIntroContainerSetting"
                    text="#Archipelago_Settings_SkipIntroContainer"
                    convar="cv_SkipIntroContainerScene"
                    psvar="cv_SkipIntroContainerScene"
                    infomessage="#Archipelago_Settings_SkipIntroContainer_info"
                    hasdocspage="false"
                >
                    <RadioButton group="cv_SkipIntroContainerScene" text="#Common_Off" value="0" activateoverride="UiToolkitAPI.GetGlobalObject().SyncSkipSettingsIfInGame?.()" />
                    <RadioButton group="cv_SkipIntroContainerScene" text="#Common_On" value="1" activateoverride="UiToolkitAPI.GetGlobalObject().SyncSkipSettingsIfInGame?.()" />
                </SettingsEnum>

                <SettingsEnum
                    id="SkipBirdSceneSetting"
                    text="#Archipelago_Settings_SkipBirdScene"
                    convar="cv_SkipBirdScene"
                    psvar="cv_SkipBirdScene"
                    infomessage="#Archipelago_Settings_SkipBirdScene_info"
                    hasdocspage="false"
                >
                    <RadioButton group="cv_SkipBirdScene" text="#Common_Off" value="0" activateoverride="UiToolkitAPI.GetGlobalObject().SyncSkipSettingsIfInGame?.()" />
                    <RadioButton group="cv_SkipBirdScene" text="#Common_On" value="1" activateoverride="UiToolkitAPI.GetGlobalObject().SyncSkipSettingsIfInGame?.()" />
                </SettingsEnum>

                <SettingsEnum
                    id="SkipCeilingSceneSetting"
                    text="#Archipelago_Settings_SkipCeilingScene"
                    convar="cv_SkipCeilingScene"
                    psvar="cv_SkipCeilingScene"
                    infomessage="#Archipelago_Settings_SkipCeilingScene_info"
                    hasdocspage="false"
                >
                    <RadioButton group="cv_SkipCeilingScene" text="#Common_Off" value="0" activateoverride="UiToolkitAPI.GetGlobalObject().SyncSkipSettingsIfInGame?.()" />
                    <RadioButton group="cv_SkipCeilingScene" text="#Common_On" value="1" activateoverride="UiToolkitAPI.GetGlobalObject().SyncSkipSettingsIfInGame?.()" />
                </SettingsEnum>
            </Panel>

            <Panel class="settings-page__spacer" />
        </Panel>
    </Panel>
</root>